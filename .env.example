# URL da aplicação em produção (ex: https://busca-ativa-leopoldina.vercel.app)
NEXTAUTH_URL="https://seu-dominio.vercel.app"

# Chave secreta de sessão do NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="gere-uma-chave-secreta-forte-com-openssl"

# URL do banco de dados PostgreSQL na nuvem (Neon / Supabase)
DATABASE_URL="postgres://usuario:senha@host-pooler:5432/nome_do_banco?sslmode=require"
DIRECT_URL="postgres://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Credenciais Google OAuth (obrigatório para login institucional @escola.pr.gov.br)
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# E-mail institucional do Administrador raiz (correspondência exata)
ADMIN_EMAIL="marcos.wrobel@escola.pr.gov.br"

# Token secreto exigido pela Extensão Chrome para sincronizar Power BI e SERP (gere com: openssl rand -hex 24)
SYNC_API_TOKEN="gere-um-token-aleatorio-forte-com-openssl-rand-hex-24"

# Chave opcional da API Google Gemini para geração de modelos com IA
GEMINI_API_KEY=""
