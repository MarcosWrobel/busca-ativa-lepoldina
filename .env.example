# URL da aplicação em produção (ex: https://busca-ativa-leopoldina.vercel.app)
NEXTAUTH_URL="https://seu-dominio.vercel.app"

# Chave secreta de sessão do NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="gere-uma-chave-secreta-forte-com-openssl-ou-qualquer-string-longa"

# URL do banco de dados PostgreSQL na nuvem (Supabase, Neon, ou Vercel Postgres)
DATABASE_URL="postgres://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Credenciais Google OAuth (obrigatório para login institucional em produção)
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
