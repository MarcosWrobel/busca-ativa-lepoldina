{
  "manifest_version": 3,
  "name": "Sincronizador Leopoldina (Power BI & SERP)",
  "version": "1.1.0",
  "description": "Extrai dados de frequência do Power BI e fichas da Rede de Proteção (SERP) para o Sistema de Busca Ativa.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sincronizador Leopoldina"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://app.powerbi.com/*",
    "*://*.redeprotecao.seed.pr.gov.br/*",
    "*://redeprotecao.seed.pr.gov.br/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://app.powerbi.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://app.powerbi.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.redeprotecao.seed.pr.gov.br/*",
        "*://redeprotecao.seed.pr.gov.br/*"
      ],
      "js": ["serp-content.js"],
      "world": "ISOLATED",
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
