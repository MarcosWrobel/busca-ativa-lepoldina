generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id              String            @id @default(cuid())
  inepCode        String            @unique // e.g. "41042730"
  name            String            // e.g. "Colégio Estadual Leopoldina B. Pedroso"
  city            String            @default("Ponta Grossa")
  state           String            @default("PR")
  nre             String            @default("Ponta Grossa") // Núcleo Regional de Educação
  phone           String?
  email           String?
  logoUrl         String?
  active          Boolean           @default(true)
  syncTokenHash   String?           // Token hash para sincronização com extensões
  settingsJson    String?           // Configurações e preferências personalizadas
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users           User[]
  classGroups     ClassGroup[]
  students        Student[]
  templates       MessageTemplate[]
  auditLogs       AuditLog[]
  pedagogicalMinutes PedagogicalMinute[]

  @@index([inepCode])
  @@index([active])
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  image         String?
  role          String       @default("PEDAGOGA") // ADMIN | PEDAGOGA
  active        Boolean      @default(true)
  schoolId      String?
  school        School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  messageLogs   MessageLog[] @relation("SentByUser")
  repliedLogs   MessageLog[] @relation("RepliedByUser")
  auditLogs     AuditLog[]

  @@index([schoolId])
}

model ClassGroup {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "6º 1", "1º ADM", "2º Série"
  segment   String    // FUNDAMENTAL | MEDIO | NOTURNO
  shift     String    @default("MANHA") // MANHA | TARDE | NOITE
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  students  Student[]

  @@index([segment, shift])
  @@index([schoolId])
}

model Student {
  id                   String                @id @default(cuid())
  cgm                  String?               @unique // Cadastro Geral de Matrícula (SEED-PR)
  name                 String
  guardianName         String?
  phone                String                // e.g. "42988189394"
  classGroupId         String
  classGroup           ClassGroup            @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  schoolId             String?
  school               School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  messageLogs          MessageLog[]
  lowAttendanceRecord  LowAttendanceRecord?
  contacts             StudentContact[]
  justifications       AbsenceJustification[]
  inPersonAttendances  InPersonAttendance[]
  pedagogicalMinuteLinks PedagogicalMinuteStudent[]
  attendanceSnapshots  AttendanceSnapshot[]

  @@index([classGroupId, active])
  @@index([name])
  @@index([schoolId])
}

model MessageTemplate {
  id               String       @id @default(cuid())
  title            String       // e.g. "ALUNO FALTOU"
  segment          String       @default("TODOS") // TODOS | FUNDAMENTAL | MEDIO | NOTURNO
  prefixText       String       // Text before student name
  suffixText       String       // Text after student name
  isAbsenceRelated Boolean      @default(false)
  active           Boolean      @default(true)
  schoolId         String?
  school           School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  messageLogs      MessageLog[]

  @@index([active, segment])
  @@index([isAbsenceRelated])
  @@index([schoolId])
}

model MessageLog {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId      String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reasonTitle     String
  messageContent  String
  phoneUsed       String
  sentByUserId    String?
  sentByUser      User?            @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sentByName      String           // Stored snapshot of pedagoga name
  guardianReplied   Boolean          @default(false)
  replyNotes        String?
  replyCategory     String?          // SAUDE | TRANSPORTE | TRABALHO | VIAGEM_FAMILIAR | VULNERABILIDADE | SEM_JUSTIFICATIVA | OUTROS
  repliedAt         DateTime?
  repliedByUserId   String?
  repliedByUser     User?            @relation("RepliedByUser", fields: [repliedByUserId], references: [id], onDelete: SetNull)
  deliveryStatus    String           @default("SENT") // LINK_OPENED | SENT | DELIVERED | READ | FAILED_NO_WHATSAPP
  deliveryUpdatedAt DateTime?
  sentAt            DateTime         @default(now())

  @@index([sentAt(sort: Desc)])
  @@index([studentId, sentAt(sort: Desc)])
  @@index([guardianReplied])
  @@index([sentByName])
  @@index([reasonTitle])
  @@index([deliveryStatus])
  @@index([replyCategory])
}

model LowAttendanceRecord {
  id                String    @id @default(cuid())
  studentId         String    @unique
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendancePercent Float     // e.g. 51.15
  enrollmentDetail  String?   // e.g. "Matrícula única"
  actionsTaken      String?   // e.g. "4 buscas SERP - ENCAMINHAR CT"
  serpProtocol      String?   // Número da Ficha SERP/FICAI
  serpStatus        String?   // "CONSELHO_TUTELAR" | "EM_ACOMPANHAMENTO" | "MINISTERIO_PUBLICO" | "ARQUIVADO"
  serpOpenedAt      DateTime? // Data de abertura no SERP
  serpDetails       String?   // Histórico de buscas ativas e anotações do SERP
  updatedAt         DateTime  @updatedAt

  @@index([attendancePercent])
  @@index([serpStatus])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  userName   String
  action     String   // SEND_MESSAGE | CREATE_STUDENT | UPDATE_STUDENT | DELETE_STUDENT | MARK_REPLY | TEMPLATE_CHANGE | LOGIN
  entityType String   // Student | MessageLog | MessageTemplate | LowAttendance
  entityId   String?
  details    String?  // JSON string with previous/new state or description
  ipAddress  String?
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([schoolId])
}

model AttendanceSnapshot {
  id                    String   @id @default(cuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  referenceWeek         String   // e.g. "2026-W44"
  attendancePercent     Float
  weeklyPercent         Float?
  previousWeeklyPercent Float?
  recordedAt            DateTime @default(now())

  @@unique([studentId, referenceWeek])
  @@index([studentId, recordedAt(sort: Desc)])
}

model StudentContact {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  kinship       String   @default("RESPONSAVEL") // MAE | PAI | AVOS | TIOS | IRMAOS | RECADO | PROPRIO_ALUNO | RESPONSAVEL
  phone         String
  isPrimary     Boolean  @default(false)
  whatsappValid Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId, isPrimary])
}

model AbsenceJustification {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           String   @default("ATESTADO_MEDICO") // ATESTADO_MEDICO | ATESTADO_ODONTOLOGICO | DECLARACAO_COMPARECIMENTO | JUSTIFICATIVA_FAMILIAR | DISPENSA_LEGAL
  startDate      DateTime
  endDate        DateTime
  cidCode        String?
  notes          String?
  createdByName  String
  createdByEmail String
  createdAt      DateTime @default(now())

  @@index([studentId, endDate(sort: Desc)])
  @@index([startDate, endDate])
}

model InPersonAttendance {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendedAt      DateTime @default(now())
  guardianPresent String
  subject         String
  summary         String
  agreements      String?
  recordedByName  String
  recordedByEmail String
  createdAt       DateTime @default(now())

  @@index([studentId, attendedAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// LIVRO OFICIAL DE ATAS DO ATENDIMENTO PEDAGÓGICO (LEI 14.063/2020 & ECA)
// ---------------------------------------------------------------------------

model PedagogicalMinute {
  id                    String                         @id @default(cuid())
  schoolId              String
  school                School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year                  Int                            // Ano do livro oficial (ex: 2026)
  ataNumber             Int?                           // Número sequencial anual (ex: 1, 2, 42). Null enquanto rascunho.
  status                String                         @default("DRAFT") // DRAFT | FINALIZED | VOIDED
  category              String                         @default("ACOMPANHAMENTO_PEDAGOGICO") // BUSCA_ATIVA_FALTAS | CONVIVENCIA_INDISCIPLINA | ACOMPANHAMENTO_PEDAGOGICO | SAUDE_VULNERABILIDADE | REDE_PROTECAO_CT | ORIENTACAO_ROTINA
  isConfidential        Boolean                        @default(false) // Sigilo reforçado (ECA/LGPD) - não sai no dossiê comum sem confirmação explícita
  attendedAt            DateTime                       @default(now())
  subject               String                         // Assunto / Pauta do atendimento
  rawNotes              String?                        // Notas livres / transcrição bruta de rascunho
  summary               String                         // Texto formal da ata em linguagem oficial
  agreementsSummary     String?                        // Resumo dos combinados/encaminhamentos
  
  // Fé Pública e Servidor Responsável pela Lavratura
  authorId              String?
  authorName            String
  authorEmail           String
  authorRole            String                         @default("PEDAGOGA")
  authorIp              String?
  finalizedAt           DateTime?
  
  // Integridade e Validação Jurídica
  contentHash           String?                        // SHA-256 canônico gerado no momento da lavratura
  verificationCode      String?                        @unique // Código curto aleatório não sequencial para o QR Code público
  physicalSignedScanData String?                       // Base64 compactado de imagem/PDF da via física assinada
  
  // Averbação de Cancelamento ("Tornada Sem Efeito")
  voidedAt              DateTime?
  voidedByName          String?
  voidedByEmail         String?
  voidReason            String?
  
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  students              PedagogicalMinuteStudent[]
  participants          PedagogicalMinuteParticipant[]
  addendums             PedagogicalMinuteAddendum[]
  actionItems           PedagogicalActionItem[]

  @@unique([schoolId, year, ataNumber])
  @@index([schoolId, year, status])
  @@index([schoolId, attendedAt(sort: Desc)])
  @@index([verificationCode])
}

model PedagogicalMinuteStudent {
  id                  String            @id @default(cuid())
  minuteId            String
  minute              PedagogicalMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Snapshot imutável no momento da vinculação
  studentNameSnapshot String
  classNameSnapshot   String?
  cgmSnapshot         String?

  createdAt           DateTime          @default(now())

  @@unique([minuteId, studentId])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([minuteId])
}

model PedagogicalMinuteParticipant {
  id                      String            @id @default(cuid())
  minuteId                String
  minute                  PedagogicalMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  
  role                    String            // RESPONSAVEL | ESTUDANTE | PROFESSOR | EQUIPE_ESCOLAR | REDE_EXTERNA | TESTEMUNHA
  studentId               String?           // Aluno de referência quando aplicável
  name                    String
  kinship                 String?           // Grau de parentesco se responsável
  documentType            String?           // CPF | RG | MATRICULA | OUTRO
  documentNumber          String?
  documentVerifiedByStaff Boolean           @default(false) // Pedagoga atesta conferência com fé pública
  phone                   String?
  
  signatureMode           String            @default("PENDING") // PENDING | SCREEN_CANVAS | MOBILE_QR | PAPER_A4 | REFUSED
  signatureData           String?           // Imagem de traço vetorial/SVG ou PNG compactado (data URL)
  signedAt                DateTime?
  signerIp                String?
  refusalReason           String?           // Justificativa caso tenha se recusado a assinar
  witnessName             String?           // Servidor/testemunha presencial se houver recusa
  
  mobileSignToken         String?           @unique // Token temporário para assinar pelo celular via QR Code
  mobileSignExpiresAt     DateTime?

  createdAt               DateTime          @default(now())

  @@index([minuteId])
  @@index([mobileSignToken])
}

model PedagogicalMinuteAddendum {
  id                       String            @id @default(cuid())
  minuteId                 String
  minute                   PedagogicalMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  
  content                  String            // Texto do aditamento ("Em tempo: ...")
  authorName               String
  authorEmail              String
  authorIp                 String?
  previousHash             String            // Hash encadeado da ata ou do adendo imediatamente anterior
  addendumHash             String            // Novo hash resultante (hash-chaining)
  
  participantSignatureData String?           // Assinatura de participante no adendo se houver
  participantSignerName    String?
  
  createdAt                DateTime          @default(now())

  @@index([minuteId, createdAt(sort: Asc)])
}

model PedagogicalActionItem {
  id              String            @id @default(cuid())
  minuteId        String
  minute          PedagogicalMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  
  description     String
  responsible     String            @default("FAMILIA") // FAMILIA | ESTUDANTE | ESCOLA | REDE_PROTECAO
  dueDate         DateTime?
  status          String            @default("PENDING") // PENDING | COMPLETED | CANCELED
  completedAt     DateTime?
  completedByName String?
  completionNotes String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([minuteId])
  @@index([status, dueDate])
}
