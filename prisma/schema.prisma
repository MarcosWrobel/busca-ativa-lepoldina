generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  image         String?
  role          String       @default("PEDAGOGA") // ADMIN | PEDAGOGA
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  messageLogs   MessageLog[] @relation("SentByUser")
  repliedLogs   MessageLog[] @relation("RepliedByUser")
  auditLogs     AuditLog[]
}

model ClassGroup {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "6º 1", "1º ADM", "2º Série"
  segment   String    // FUNDAMENTAL | MEDIO | NOTURNO
  shift     String    @default("MANHA") // MANHA | TARDE | NOITE
  createdAt DateTime  @default(now())

  students  Student[]

  @@index([segment, shift])
}

model Student {
  id                   String                @id @default(cuid())
  cgm                  String?               @unique // Cadastro Geral de Matrícula (SEED-PR)
  name                 String
  guardianName         String?
  phone                String                // e.g. "42988189394"
  classGroupId         String
  classGroup           ClassGroup            @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  messageLogs          MessageLog[]
  lowAttendanceRecord  LowAttendanceRecord?
  contacts             StudentContact[]
  justifications       AbsenceJustification[]
  inPersonAttendances  InPersonAttendance[]
  attendanceSnapshots  AttendanceSnapshot[]

  @@index([classGroupId, active])
  @@index([name])
}

model MessageTemplate {
  id               String       @id @default(cuid())
  title            String       // e.g. "ALUNO FALTOU"
  segment          String       @default("TODOS") // TODOS | FUNDAMENTAL | MEDIO | NOTURNO
  prefixText       String       // Text before student name
  suffixText       String       // Text after student name
  isAbsenceRelated Boolean      @default(false)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())

  messageLogs      MessageLog[]

  @@index([active, segment])
  @@index([isAbsenceRelated])
}

model MessageLog {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId      String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reasonTitle     String
  messageContent  String
  phoneUsed       String
  sentByUserId    String?
  sentByUser      User?            @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sentByName      String           // Stored snapshot of pedagoga name
  guardianReplied Boolean          @default(false)
  replyNotes      String?
  repliedAt       DateTime?
  repliedByUserId String?
  repliedByUser   User?            @relation("RepliedByUser", fields: [repliedByUserId], references: [id], onDelete: SetNull)
  sentAt          DateTime         @default(now())

  @@index([sentAt(sort: Desc)])
  @@index([studentId, sentAt(sort: Desc)])
  @@index([guardianReplied])
  @@index([sentByName])
  @@index([reasonTitle])
}

model LowAttendanceRecord {
  id                String    @id @default(cuid())
  studentId         String    @unique
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendancePercent Float     // e.g. 51.15
  enrollmentDetail  String?   // e.g. "Matrícula única"
  actionsTaken      String?   // e.g. "4 buscas SERP - ENCAMINHAR CT"
  serpProtocol      String?   // Número da Ficha SERP/FICAI
  serpStatus        String?   // "CONSELHO_TUTELAR" | "EM_ACOMPANHAMENTO" | "MINISTERIO_PUBLICO" | "ARQUIVADO"
  serpOpenedAt      DateTime? // Data de abertura no SERP
  serpDetails       String?   // Histórico de buscas ativas e anotações do SERP
  updatedAt         DateTime  @updatedAt

  @@index([attendancePercent])
  @@index([serpStatus])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  userName   String
  action     String   // SEND_MESSAGE | CREATE_STUDENT | UPDATE_STUDENT | DELETE_STUDENT | MARK_REPLY | TEMPLATE_CHANGE | LOGIN
  entityType String   // Student | MessageLog | MessageTemplate | LowAttendance
  entityId   String?
  details    String?  // JSON string with previous/new state or description
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
}

model AttendanceSnapshot {
  id                    String   @id @default(cuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  referenceWeek         String   // e.g. "2026-W44"
  attendancePercent     Float
  weeklyPercent         Float?
  previousWeeklyPercent Float?
  recordedAt            DateTime @default(now())

  @@unique([studentId, referenceWeek])
  @@index([studentId, recordedAt(sort: Desc)])
}

model StudentContact {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  kinship       String   @default("RESPONSAVEL") // MAE | PAI | AVOS | TIOS | IRMAOS | RECADO | PROPRIO_ALUNO | RESPONSAVEL
  phone         String
  isPrimary     Boolean  @default(false)
  whatsappValid Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId, isPrimary])
}

model AbsenceJustification {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           String   @default("ATESTADO_MEDICO") // ATESTADO_MEDICO | ATESTADO_ODONTOLOGICO | DECLARACAO_COMPARECIMENTO | JUSTIFICATIVA_FAMILIAR | DISPENSA_LEGAL
  startDate      DateTime
  endDate        DateTime
  cidCode        String?
  notes          String?
  createdByName  String
  createdByEmail String
  createdAt      DateTime @default(now())

  @@index([studentId, endDate(sort: Desc)])
  @@index([startDate, endDate])
}

model InPersonAttendance {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendedAt      DateTime @default(now())
  guardianPresent String
  subject         String
  summary         String
  agreements      String?
  recordedByName  String
  recordedByEmail String
  createdAt       DateTime @default(now())

  @@index([studentId, attendedAt(sort: Desc)])
}
